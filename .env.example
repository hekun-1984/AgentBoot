# 复制为 .env 后按需修改。未配置 API Key 时，框架使用 Agent 内置计划，不会请求模型。
AGENTBOOT_LLM_MODEL=gpt-4o-mini
AGENTBOOT_LLM_API_KEY=
AGENTBOOT_LLM_BASE_URL=https://api.openai.com/v1
AGENTBOOT_LLM_TEMPERATURE=0
AGENTBOOT_LOG_LEVEL=INFO
# native：内置并行调度器。langgraph：把同一份 ExecutionPlan 编译为 StateGraph。
AGENTBOOT_ENGINE=native
# true 时 python main.py 会跑已注册 Agent 的示例上下文。
AGENTBOOT_DEMO=true
